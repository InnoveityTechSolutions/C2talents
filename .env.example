# ==========================================
# C2Talents Environment Variables Template
# ==========================================
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your real '.env' file or secret credentials to Git.

# Primary Database Connection String (MySQL / Aiven / Local)
DATABASE_URL="mysql://avnadmin:YOUR_PASSWORD@YOUR_AIVEN_HOST:10018/defaultdb?ssl-mode=REQUIRED"

# Optional: Local Database URL for sync scripts or backups
LOCAL_DATABASE_URL="mysql://root@127.0.0.1:3306/c2talents"

# Application Environment & Base URL
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication & Security Secrets
JWT_SECRET="your_jwt_secret_here"
NEXTAUTH_SECRET="your_nextauth_secret_here"

# Google OAuth Credentials (Optional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/callback/google"

# AI Service API Keys (Optional)
GEMINI_API_KEY="your_gemini_api_key_here"
GROK_API_KEY="your_grok_api_key_here"

# SMTP Email Configuration (Optional)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"
SMTP_FROM="\"C2Talents Platform\" <no-reply@c2talents.com>"
